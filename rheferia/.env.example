# ---------------------------------------------------------------------------
# Rheferia environment configuration
# Copy to .env.local and fill in values. NEVER commit real .env files.
# See docs/PROVIDER-SETUP.md for what each value enables and how to get it.
# ---------------------------------------------------------------------------

# Public application configuration (safe to expose to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service role key: enables durable Postgres guest limits.
# NEVER expose to the browser bundle. See docs/SUPABASE-SETUP.md.
SUPABASE_SERVICE_ROLE_KEY=

# Research providers; verify current provider requirements in the provider docs
OPENALEX_API_KEY=
CROSSREF_CONTACT_EMAIL=
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
BRAVE_SEARCH_API_KEY=

# Cloud document conversion (PDF to Word and Word to PDF)
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_WEBHOOK_SECRET=
CLOUDCONVERT_SANDBOX=false

# Server-side application controls
APP_MODE=live
CRON_SECRET=
RATE_LIMIT_SECRET=
TEMP_FILE_RETENTION_HOURS=24
MAX_CLOUD_UPLOAD_MIB=25
MAX_DAILY_CLOUD_CONVERSIONS=5
MAX_CONCURRENT_CLOUD_CONVERSIONS=2
MAX_PROVIDER_REQUESTS_PER_SEARCH=6
